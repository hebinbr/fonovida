{
  "entities": {
    "TherapistProfile": {
      "title": "TherapistProfile",
      "description": "Perfil profissional da fonoaudióloga autenticada e suas preferências padrão de lembretes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "crfa": { "type": "string" },
        "clinicName": { "type": "string" },
        "defaultReminderMinutes": { "type": "integer" },
        "autoRemindersEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "displayName",
        "defaultReminderMinutes",
        "autoRemindersEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "Patient": {
      "title": "Patient",
      "description": "Cadastro de paciente acompanhado pela fonoaudióloga, com dados do responsável e meta semanal de exercícios de voz.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "ageYears": { "type": "integer" },
        "clinicalFocus": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "guardianEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "PAUSA", "ALTA"] },
        "weeklyGoalMinutes": { "type": "integer" },
        "initialNotes": { "type": "string" },
        "dailyExerciseReminderEnabled": { "type": "boolean" },
        "reminderHour": { "type": "integer" },
        "reminderMinute": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "fullName",
        "ageYears",
        "clinicalFocus",
        "guardianName",
        "status",
        "weeklyGoalMinutes",
        "dailyExerciseReminderEnabled",
        "reminderHour",
        "reminderMinute",
        "createdAt",
        "updatedAt"
      ]
    },
    "VoiceExercise": {
      "title": "VoiceExercise",
      "description": "Exercício de voz prescrito para um paciente específico.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["RESPIRACAO", "RESSONANCIA", "ARTICULACAO", "PROSODIA", "AQUECIMENTO"] },
        "instructions": { "type": "string" },
        "targetDurationMinutes": { "type": "integer" },
        "frequencyPerWeek": { "type": "integer" },
        "activeFlag": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "patientId",
        "title",
        "category",
        "instructions",
        "targetDurationMinutes",
        "frequencyPerWeek",
        "activeFlag",
        "createdAt",
        "updatedAt"
      ]
    },
    "EvolutionSession": {
      "title": "EvolutionSession",
      "description": "Registro de sessão de exercício vocal com métricas clínicas e observações para histórico e relatório PDF.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "exerciseTitle": { "type": "string" },
        "category": { "type": "string", "enum": ["RESPIRACAO", "RESSONANCIA", "ARTICULACAO", "PROSODIA", "AQUECIMENTO"] },
        "durationMinutes": { "type": "integer" },
        "vocalClarityScore": { "type": "integer" },
        "stabilityScore": { "type": "integer" },
        "comfortScore": { "type": "integer" },
        "tmfSeconds": { "type": "number" },
        "clinicalNotes": { "type": "string" },
        "homeGuidance": { "type": "string" },
        "sessionDateMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "patientId",
        "patientName",
        "exerciseTitle",
        "category",
        "durationMinutes",
        "vocalClarityScore",
        "stabilityScore",
        "comfortScore",
        "tmfSeconds",
        "sessionDateMillis",
        "createdAt",
        "updatedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Consulta fonoaudiológica agendada com lembretes automáticos para a profissional e para o paciente/responsável.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "scheduledAtMillis": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "sessionType": { "type": "string", "enum": ["PRESENCIAL", "TELEFONOAUDIOLOGIA", "AVALIACAO"] },
        "status": { "type": "string", "enum": ["AGENDADA", "CONFIRMADA", "CONCLUIDA", "CANCELADA"] },
        "notes": { "type": "string" },
        "reminderEnabled": { "type": "boolean" },
        "reminderLeadMinutes": { "type": "integer" },
        "patientReminderEnabled": { "type": "boolean" },
        "patientReminderLeadMinutes": { "type": "integer" },
        "reminderSentMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "patientId",
        "patientName",
        "scheduledAtMillis",
        "durationMinutes",
        "sessionType",
        "status",
        "reminderEnabled",
        "reminderLeadMinutes",
        "reminderSentMillis",
        "createdAt",
        "updatedAt"
      ]
    },
    "SlotBlock": {
      "title": "SlotBlock",
      "description": "Horário marcado manualmente como ocupado/indisponível na agenda da fonoaudióloga.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "hour": { "type": "integer" },
        "minute": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "dateKey",
        "hour",
        "minute",
        "durationMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomExerciseList": {
      "title": "CustomExerciseList",
      "description": "Lista personalizada de exercícios vocais criada pela fonoaudióloga como protocolo reutilizável ou atribuída a um paciente.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "clinicalObjective": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "category": { "type": "string", "enum": ["RESPIRACAO", "RESSONANCIA", "ARTICULACAO", "PROSODIA", "AQUECIMENTO"] },
              "instructions": { "type": "string" },
              "durationMinutes": { "type": "integer" },
              "frequencyPerWeek": { "type": "integer" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title",
        "items",
        "createdAt",
        "updatedAt"
      ]
    },
    "PatientAccessCode": {
      "title": "PatientAccessCode",
      "description": "Código exclusivo gerado pela fonoaudióloga para liberar o acesso do paciente ao aplicativo com seus exercícios e orientações.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "therapistId": { "type": "string" },
        "therapistName": { "type": "string" },
        "clinicName": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "clinicalFocus": { "type": "string" },
        "weeklyGoalMinutes": { "type": "integer" },
        "active": { "type": "boolean" },
        "redeemedByUid": { "type": "string" },
        "redeemedAtMillis": { "type": "integer" },
        "exercisesSnapshot": { "type": "array" },
        "nextAppointmentSummary": { "type": "string" },
        "recentProgressSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "therapistId",
        "therapistName",
        "clinicName",
        "patientId",
        "patientName",
        "clinicalFocus",
        "weeklyGoalMinutes",
        "active",
        "redeemedByUid",
        "redeemedAtMillis",
        "exercisesSnapshot",
        "nextAppointmentSummary",
        "recentProgressSummary",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/TherapistProfile" },
      "description": "Perfil profissional da fonoaudióloga."
    },
    "/users/{userId}/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Pacientes acompanhados pela fonoaudióloga."
    },
    "/users/{userId}/exercises/{exerciseId}": {
      "schema": { "$ref": "#/entities/VoiceExercise" },
      "description": "Exercícios de voz prescritos aos pacientes."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/EvolutionSession" },
      "description": "Histórico de sessões de exercícios vocais e métricas de evolução."
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Agenda de consultas e lembretes automáticos."
    },
    "/users/{userId}/slotBlocks/{blockId}": {
      "schema": { "$ref": "#/entities/SlotBlock" },
      "description": "Horários marcados como ocupados/indisponíveis na agenda."
    },
    "/users/{userId}/exerciseLists/{listId}": {
      "schema": { "$ref": "#/entities/CustomExerciseList" },
      "description": "Listas personalizadas de exercícios vocais geradas pela fonoaudióloga."
    },
    "/patientAccessCodes/{codeId}": {
      "schema": { "$ref": "#/entities/PatientAccessCode" },
      "description": "Códigos gerados pela fonoaudióloga para liberação de acesso do paciente."
    }
  }
}
